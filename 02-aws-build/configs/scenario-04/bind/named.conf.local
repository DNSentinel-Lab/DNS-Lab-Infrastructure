zone "tunnel.soclab.abdul4rehman215.tech" {
        type master;
        file "/etc/bind/db.tunnel.soclab";
        allow-transfer { none; };
};

logging {
    channel scenario04_queries {
        file "/var/log/named/scenario04-queries.log" versions 5 size 10m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    category queries {
        scenario04_queries;
    };
};
