flowchart LR

    %% =====================================================
    %% 1 · EXTERNAL ADVERSARY
    %% =====================================================
    subgraph EXT[" "]
        direction TB

        H1["🎭 1 · EXTERNAL ACTIVITY"]

        A["🌍 Project Lead / Adversary<br/>Separate External Source"]

        Q["🔎 Public DNS Recon<br/>A · AAAA · MX · NS · TXT<br/>Optional AXFR"]

        H1 ==> A ==> Q
    end


    %% =====================================================
    %% 2 · PUBLIC DNS + WEB
    %% =====================================================
    subgraph PUBLIC[" "]
        direction TB

        H2["🌐 2 · PUBLIC LAB SURFACE"]

        P["🏠 Route 53 Parent DNS<br/>Delegation / NS Referral"]

        C["🧪 Route 53 Child DNS<br/>Authoritative Responses"]

        W["🖥️ Public Web Target<br/>Optional HTTP / HTTPS Follow-Up"]

        H2 ==> P
        P ==> C
        C ==> W
    end


    %% =====================================================
    %% 3 · DETECTION + AI
    %% =====================================================
    subgraph DETECT[" "]
        direction TB

        H3["📡 3 · DETECTION + AI"]

        S["🟢 Splunk Enterprise<br/>DNS + Web + Network Evidence<br/>Detection v1.0"]

        L["🤖 AI Bridge<br/>Webhook → AI Context → HEC"]

        H3 ==> S
        S <==> L
    end


    %% =====================================================
    %% 4 · HUMAN DECISION
    %% =====================================================
    subgraph HUMAN[" "]
        direction TB

        H4["🛡️ 4 · HUMAN DECISION"]

        SOC["🔎 SOC Analyst<br/>Validate Raw Evidence<br/>History + Correlations"]

        IR["🚨 IR / Defender<br/>Evidence-Backed Escalation<br/>Response + Verification"]

        GT["🔓 GROUND TRUTH REVEAL<br/>Only After SOC Disposition<br/>+ IR Handoff Are Locked"]

        H4 ==> SOC ==> IR
        IR -.-> GT
    end


    %% =====================================================
    %% MAIN FLOW
    %% =====================================================
    Q ==> P

    C ==> S
    W ==> S

    S ==> SOC


    %% =====================================================
    %% HIDDEN-GROUND-TRUTH RELATIONSHIP
    %% =====================================================
    A -.-> GT


