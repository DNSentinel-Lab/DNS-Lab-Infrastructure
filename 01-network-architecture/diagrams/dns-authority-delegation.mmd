    %% =====================================================
    classDef rootHeader fill:#3b2506,stroke:#facc15,stroke-width:5px,color:#ffffff,font-size:28px;
    classDef parentHeader fill:#1e1b4b,stroke:#a78bfa,stroke-width:5px,color:#ffffff,font-size:28px;
    classDef childHeader fill:#082f49,stroke:#38bdf8,stroke-width:5px,color:#ffffff,font-size:28px;
    classDef targetHeader fill:#14532d,stroke:#4ade80,stroke-width:5px,color:#ffffff,font-size:28px;

    class RH rootHeader;
    class PH parentHeader;
    class CH childHeader;
    class TH targetHeader;


    %% =====================================================
    %% PREMIUM NODE STYLES
    %% =====================================================
    classDef registrar fill:#7c2d12,stroke:#fb923c,stroke-width:4px,color:#ffffff,font-size:26px;
    classDef registry fill:#422006,stroke:#facc15,stroke-width:4px,color:#ffffff,font-size:26px;

    classDef parent fill:#312e81,stroke:#a78bfa,stroke-width:5px,color:#ffffff,font-size:26px;
    classDef parentRec fill:#1f2937,stroke:#cbd5e1,stroke-width:4px,color:#ffffff,font-size:24px;
    classDef delegation fill:#581c87,stroke:#e879f9,stroke-width:5px,color:#ffffff,font-size:24px;

    classDef child fill:#0c4a6e,stroke:#38bdf8,stroke-width:5px,color:#ffffff,font-size:26px;
    classDef txt fill:#134e4a,stroke:#2dd4bf,stroke-width:4px,color:#ffffff,font-size:24px;
    classDef arec fill:#14532d,stroke:#4ade80,stroke-width:5px,color:#ffffff,font-size:24px;
    classDef cname fill:#4338ca,stroke:#818cf8,stroke-width:4px,color:#ffffff,font-size:24px;

    classDef web fill:#991b1b,stroke:#fb7185,stroke-width:5px,color:#ffffff,font-size:26px;


    %% =====================================================
    %% APPLY NODE STYLES
    %% =====================================================
    class Registrar registrar;
    class TLD registry;

    class Parent parent;
    class ParentSite,ParentMail parentRec;
    class ChildNS delegation;

    class Child child;
    class TXT txt;
    class Apex arec;
    class WWW cname;
    class TunnelNS delegation;

    class Web web;
    class TunnelAuth child;


    %% =====================================================
    %% GLOSSY CONTAINER PANELS
    %% =====================================================
    style ROOT fill:#0b0d18,stroke:#facc15,stroke-width:2px
    style PARENT fill:#0d1022,stroke:#a78bfa,stroke-width:2px
    style PREC fill:#101826,stroke:#334155,stroke-width:1px
    style CHILD fill:#071822,stroke:#38bdf8,stroke-width:2px
    style CREC fill:#101826,stroke:#334155,stroke-width:1px
    style TARGET fill:#07140e,stroke:#4ade80,stroke-width:2px


    %% =====================================================
    %% BRIGHT CONNECTORS
    %% =====================================================
    linkStyle default stroke:#e2e8f0,stroke-width:5px;
